# Настройки проекта (шаблон). Скопируйте в settings.env и заполните своими значениями.
# settings.env НЕ хранится в git (см. .gitignore); этот файл-пример — коммитится.
#
# ВАЖНО: все значения здесь ОБЕЗЛИЧЕНЫ (заглушки example.com / пустые токены) —
# это не рабочие данные, а только подсказка по набору ключей.
#
# Формат: KEY=value (строки с # — комментарии; кавычки вокруг значения не нужны).
# Настройки читаются только из settings.env;

# --- LLM (любой OpenAI-совместимый API) ---
# Локальный сервер (Ollama):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=your-model-name
# API-ключ LLM (для локального сервера не обязателен).
LLM_API_KEY=EMPTY

# --- GitLab ---
# Базовый URL GitLab (без /api/v4).
GITLAB_API_URL=https://gitlab.example.com
# Токен GitLab.
# GITLAB_TOKEN=
# ID проекта по умолчанию для get_diff_mr (иначе запрашивается при запуске).
# GITLAB_PROJECT_ID=12345

# --- TLS / сертификаты (опционально) ---
# Корневой CA для приватного GitLab; если не задан — системный набор сертификатов.
# CA_BUNDLE=C:\path\to\ca-bundle.crt

# --- Каталог шаблонов/чек-листов (docs, опционально) ---
# Каталог, где LLM-скрипты ищут .md-шаблоны и чек-листы (описание, ревью и т.п.).
# Если не задан — используется docs/ рядом с запускаемым файлом.
# (корень репо для исходников, рядом с .exe для собранных скриптов).
# DOCS_DIR=C:\path\to\docs
# Имена файлов шаблонов/чек-листов (переопределение дефолтных имён):
DOCS_TEMPLATE_DESCRIPTION=file_template_description.md
DOCS_TEMPLATE_REVIEW=file_template_review.md
DOCS_CHECKLIST_REVIEW=checklist_test_review.md
# DOCS_USER_RULES=user_rules.md   # дополнительные (редактируемые) правила для нейронки при ревью

# --- Деплой .exe (опционально) ---
# Каталог деплоя собранных .exe (используется BUILD_bat\_move.bat).
# Читается из src\settings.env напрямую; указывайте полный путь целевой папки
# (желательно с завершающим \). Если ключ не задан — _move.bat спросит путь интерактивно.
# DEPLOY_DIR=C:\path\to\VAtest

# --- Дефолтные переменные пайплайна (опционально) ---
# Путь к JSON-файлу с дефолтными переменными
# (объединяется с конфигом при запуске
# пайплайна). Если не задан — run_pipeline_default_variables.json рядом с запускаемым файлом.
# DEFAULT_VARIABLES_FILE=C:\path\to\run_pipeline_default_variables.json
